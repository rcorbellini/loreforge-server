{"bebibilidade": <inteiro 0-10>, "hidratacao": <inteiro 0-10>, "embriaguez": <inteiro 0-10>, "toxicidade": <inteiro 0-10>, "consumo": <inteiro 0-10>, "descricao": "<texto curto e factual do novo estado físico do recipiente>"}

